<?xml version="1.0" encoding="utf-8"?>
<!-- Android 11 and older (android:fullBackupContent). The session token is encrypted with a Keystore key that is
     never backed up, so a restored copy would be undecryptable; excluding it keeps the backup free of credentials. -->
<full-backup-content>
    <exclude domain="file" path="datastore/session.preferences_pb" />
</full-backup-content>
